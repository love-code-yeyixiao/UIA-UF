#include <winver.h>

// 版本资源模板，由 CMake 的 configure_file 生成到构建目录。
// 版本号来自 project(UIA-UF VERSION ...)，不要在这里硬编码。
//
// 数值常量说明（避免依赖 winver.h）：
//   FILEOS   0x40004 = VOS_NT_WINDOWS32
//   FILETYPE 0x1     = VFT_APP

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x1L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@UIAUF_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@UIAUF_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@UIAUF_ORIGINAL_FILENAME@"
            VALUE "ProductName", "UIA-UF"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
